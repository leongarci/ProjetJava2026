<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AccueilController"
      stylesheets="/styles/styles.css"
      prefWidth="780" prefHeight="520"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #f7f6f2;">

   <VBox alignment="CENTER" spacing="0" VBox.vgrow="ALWAYS">

      <Label text="🕶" style="-fx-font-size: 56px; -fx-padding: 0 0 16 0;"/>

      <Label text="La Fabrique de Lunettes"
             styleClass="hero-title"/>

      <Label text="Commandez vos lunettes sur-mesure, suivez leur fabrication en temps réel."
             styleClass="hero-subtitle"
             wrapText="true" maxWidth="420" textAlignment="CENTER"
             style="-fx-padding: 10 0 40 0;"/>

      <VBox alignment="CENTER" spacing="12" maxWidth="280">
         <Button fx:id="btnEntrer"
                 text="✦  Passer une commande"
                 styleClass="btn-primary"
                 maxWidth="Infinity"
                 prefHeight="46"
                 onAction="#onEntrerClique"/>
         <Button fx:id="btnVerifier"
                 text="Vérifier un numéro de série"
                 styleClass="btn-secondary"
                 maxWidth="Infinity"
                 prefHeight="46"
                 onAction="#onVerifierCliquer"/>
      </VBox>
   </VBox>

   <HBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
      <Label text="Jung Maxime · Garcia Léon · Holder Jules · Rosina José"
             styleClass="footer-authors"/>
   </HBox>
</VBox>