<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CatalogueController"
      stylesheets="/styles/styles.css"
      prefWidth="900" prefHeight="640" spacing="0"
      style="-fx-background-color: #f7f6f2;">

    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10">
        <Label text="🕶" style="-fx-font-size:18px;"/>
        <Label text="La Fabrique de Lunettes" styleClass="topbar-brand"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="CATALOGUE" styleClass="topbar-tag"/>
    </HBox>

    <VBox style="-fx-padding: 28 32 20 32;" spacing="4">
        <Label text="Choisissez vos modèles" styleClass="titre-page"/>
        <Label text="Sélectionnez la quantité souhaitée pour chaque modèle (0 à 9 paires)."
               styleClass="sous-titre"/>
    </VBox>

    <HBox VBox.vgrow="ALWAYS" spacing="14"
          style="-fx-padding: 0 32 0 32; -fx-alignment: CENTER_LEFT;">

        <VBox styleClass="product-card" prefWidth="194">
            <ImageView fx:id="imgChatGPT" fitWidth="194" fitHeight="138" preserveRatio="false"
                       styleClass="product-image"/>
            <VBox styleClass="card-body" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="nameChatGPT" styleClass="product-name"/>
                    <Label fx:id="badgeChatGPT" styleClass="badge" visible="false" managed="false"/>
                </HBox>
                <Label fx:id="descChatGPT" styleClass="product-desc" wrapText="true"/>
                <Label fx:id="priceChatGPT" styleClass="product-price"
                       style="-fx-padding: 4 0 0 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 6 0 0 0;">
                    <Label text="Qté" styleClass="qty-label"/>
                    <Spinner fx:id="spinChatGPT" prefWidth="72" styleClass="qty-spinner">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9" initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="product-card" prefWidth="194">
            <ImageView fx:id="imgClaude" fitWidth="194" fitHeight="138" preserveRatio="false"
                       styleClass="product-image"/>
            <VBox styleClass="card-body" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="nameClaude" styleClass="product-name"/>
                    <Label fx:id="badgeClaude" styleClass="badge" visible="false" managed="false"/>
                </HBox>
                <Label fx:id="descClaude" styleClass="product-desc" wrapText="true"/>
                <Label fx:id="priceClaude" styleClass="product-price"
                       style="-fx-padding: 4 0 0 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 6 0 0 0;">
                    <Label text="Qté" styleClass="qty-label"/>
                    <Spinner fx:id="spinClaude" prefWidth="72" styleClass="qty-spinner">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9" initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </HBox>
            </VBox>
        </VBox>

        <!-- CARTE Le Chat -->
        <VBox styleClass="product-card" prefWidth="194">
            <ImageView fx:id="imgLeChat" fitWidth="194" fitHeight="138" preserveRatio="false"
                       styleClass="product-image"/>
            <VBox styleClass="card-body" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="nameLeChat" styleClass="product-name"/>
                    <Label fx:id="badgeLeChat" styleClass="badge" visible="false" managed="false"/>
                </HBox>
                <Label fx:id="descLeChat" styleClass="product-desc" wrapText="true"/>
                <Label fx:id="priceLeChat" styleClass="product-price"
                       style="-fx-padding: 4 0 0 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 6 0 0 0;">
                    <Label text="Qté" styleClass="qty-label"/>
                    <Spinner fx:id="spinLeChat" prefWidth="72" styleClass="qty-spinner">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9" initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="product-card" prefWidth="194">
            <ImageView fx:id="imgBanana" fitWidth="194" fitHeight="138" preserveRatio="false"
                       styleClass="product-image"/>
            <VBox styleClass="card-body" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="nameBanana" styleClass="product-name"/>
                    <Label fx:id="badgeBanana" styleClass="badge" visible="false" managed="false"/>
                </HBox>
                <Label fx:id="descBanana" styleClass="product-desc" wrapText="true"/>
                <Label fx:id="priceBanana" styleClass="product-price"
                       style="-fx-padding: 4 0 0 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 6 0 0 0;">
                    <Label text="Qté" styleClass="qty-label"/>
                    <Spinner fx:id="spinBanana" prefWidth="72" styleClass="qty-spinner">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="9" initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </HBox>
            </VBox>
        </VBox>

    </HBox>

    <HBox styleClass="bottom-bar" alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding: 14 28 14 28;">
        <Label fx:id="labelStatus" text="" styleClass="status-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Annuler" styleClass="btn-ghost"
                prefHeight="40" onAction="#onAnnulerClique"/>
        <Button fx:id="btnCommande"
                text="Passer la commande  →"
                styleClass="btn-primary"
                prefHeight="40"
                onAction="#onCommanderClique"/>
    </HBox>
</VBox>