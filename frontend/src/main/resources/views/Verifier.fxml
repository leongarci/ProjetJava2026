<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VerifierController">
    <children>
        <VBox alignment="CENTER" layoutX="150.0" layoutY="50.0" spacing="15.0">
            <children>
                <Label text="Vérification de Lunettes" style="-fx-font-size: 18px;" />
                <HBox spacing="10.0">
                    <children>
                        <Label text="N° de série :" />
                        <TextField fx:id="txtNumeroAVerifier" promptText="Ex: SN-12345" />
                    </children>
                </HBox>
                <Button text="Vérifier la validité" onAction="#onBoutonVerifierClick" />
                <Label fx:id="lblResultat" text="..." style="-fx-text-fill: blue;" />
            </children>
        </VBox>
    </children>
</AnchorPane>