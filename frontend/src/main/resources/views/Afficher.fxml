<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="400.0" prefWidth="600.0"
    xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.AfficherController">
    <children>
        <Label text="Suivi de Fabrication" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="lblStatut" text="Initialisation..." />


        <ListView fx:id="listNumerosSerie" prefHeight="250.0" prefWidth="500.0" />

        <Button fx:id="btnRetour" text="Retour à l'accueil" onAction="#onRetourClique"
            disable="true" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>